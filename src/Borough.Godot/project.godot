config_version=5

[application]

config/name="Borough"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

; 1152x648 was Godot's default and it is a THIRD of a modern screen. The city is
; drawn as an orbit over a 65.5 km map and the readout is one long line, so the
; window is the instrument's aperture rather than a preference.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/resizable=true

[dotnet]

project/assembly_name="Borough.Godot"

[rendering]

renderer/rendering_method="forward_plus"

; The directional shadow atlas, and it is FOUR cascades sharing ONE texture: at
; Godot's default 4096 each Parallel4Split gets 2048 square, spread over its slice
; of DirectionalShadowMaxDistance. A roof's silhouette is a diagonal, a diagonal
; in a shadow map is a staircase, and the step is one texel wide -- which a roof
; shadow lying on open ground shows and a wall shadow against a wall hides.
;
; ⚠ WHAT 8192 BUYS WAS MEASURED AND IT IS NARROWER THAN IT SOUNDS. Against the
; same frame at 4096: visibly finer at a close orbit (~140 m), and INDISTINGUISHABLE
; at a wide one (~420 m) and under a low sun, where the step is not what limits the
; edge. It halves the step; it does not remove it. The lever with more left in it is
; DirectionalShadowMaxDistance, 1,600 m in Main.cs, because shortening the range
; concentrates every cascade -- at the price of shadows fading out nearer the eye.
;
; ⚠ It costs ~134 MB of VRAM (8192² at 16-bit depth) and that is the whole price.
; soft_shadow_filter_quality was tried here at 4 and REMOVED AGAIN: no frame it was
; asked about differed, and a setting whose effect cannot be shown is a setting kept
; on an argument.
rendering/lights_and_shadows/directional_shadow/size=8192
