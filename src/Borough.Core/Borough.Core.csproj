<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullability and analyser settings live in Directory.Build.props. -->

  <PropertyGroup>
    <!-- Span<T>, stackalloc and the pointer work adr/0036 commits to. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The committed exp/log tables are verified against a double-precision oracle the core is not
      allowed to contain, so the test assembly has to be able to read them. adr/0038.
    -->
    <InternalsVisibleTo Include="Borough.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      docs/05 §4's lints 2, 3 and 7, and the purpose_tag uniqueness row of the same section.

      OutputItemType="Analyzer" with ReferenceOutputAssembly="false" is the mechanical form of the
      distinction adr/0003 cares about: this is a build-time input, loaded by the compiler, and not a
      *dependency* of the simulation. No type declared in Borough.Analysers can be named from here,
      and nothing it contains reaches the running core. That is why it needs no written exception
      under adr/0003's rule on core dependencies.
    -->
    <ProjectReference Include="..\Borough.Analysers\Borough.Analysers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
