  "research": {
    "sources": [
      {
        "title": "SimCity 2013 player screenshots",
        "url": "https://www.reddit.com/r/SimCity/comments/wf98pe/some_random_simcity_2013_screenshots/",
        "finding": "Visually inspected town and downtown: roof equipment, facade hierarchy, planted lots and a strong colour range. Interpretation from images, not a polygon-cost measurement."
      },
      {
        "title": "SimCity pre-release screenshots, November 2012",
        "url": "https://infinitemirai.wordpress.com/2012/11/17/sim-city-2013-screenshots/",
        "finding": "Visually inspected the city overview. Pre-release reference; the article itself questions whether an early image is concept work. Not a shipped-quality guarantee."
      },
      {
        "title": "Cities: Skylines II Steam screenshot post, June 2023",
        "url": "https://www.reddit.com/r/CitiesSkylines2/comments/1470y1t/new_screenshots_on_cities_skylines_2_steam_page/",
        "finding": "Visually inspected overview and street: fine facade divisions, window/interior variation, signage and detailed street edges. Promotional images, not performance evidence."
      },
      {
        "title": "Eugene Wong \u2014 SimCity 2013 building art direction",
        "url": "https://eugenewong.artstation.com/projects/dD5Ae",
        "finding": "Primary source: geometry/texturing benchmarks, procedural atlas overlays and ground textures/props were part of the building workflow."
      },
      {
        "title": "Colossal Order \u2014 Creating an Asset Pack",
        "url": "https://www.paradoxinteractive.com/games/cities-skylines-ii/news/beach-properties-creating-an-asset-pack",
        "finding": "Primary source: references and scale blockouts precede iterative architectural details. Visually inspected the waterfront example for railings, paving, roof articulation and planting."
      },
      {
        "title": "Poly Haven \u2014 Brick Wall 001",
        "url": "https://polyhaven.com/a/brick_wall_001",
        "finding": "CC0 photographed brick, 3 metre width; Dimitrios Savva photography and Rob Tuytel processing. The pilot embeds 2K diffuse, OpenGL normal and roughness maps."
      },
      {
        "title": "Poly Haven asset licence",
        "url": "https://polyhaven.com/license",
        "finding": "CC0 applies to downloaded asset files. Source credit retained."
      }
    ],
