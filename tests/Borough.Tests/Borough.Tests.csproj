<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullability and analyser settings live in Directory.Build.props. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      Microsoft.NET.Test.Sdk writes its own entry point, and BenchmarkEntryPoint is ours. Turning
      the generated one off is what lets one assembly answer to both `dotnet test`, which loads it
      through VSTest and never calls Main, and `dotnet run`, which calls Main and never discovers a
      test. 05 §1 puts xUnit and BenchmarkDotNet in this project; this is the price of that.
    -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The golden-hash baselines. Committed data, copied beside the test assembly so the tests read the
    same bytes CI does. Note the extensions: .gitignore inherits *.log from the .NET template and
    [Ll]og/ from it too, so a baseline named for what it is would have been silently untracked.
  -->
  <ItemGroup>
    <None Include="Golden\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\*.borough" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Rulesets the runner ships, copied beside the test assembly. They are not test fixtures — the
    golden session runs under one of them, so the test has to read the same bytes the runner does
    rather than a transcription of them, which is the property the golden baselines exist to have.
  -->
  <ItemGroup>
    <None Include="..\..\rulesets\*.toml" Link="Rulesets\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Borough.Core\Borough.Core.csproj" />
    <ProjectReference Include="..\..\src\Borough.Formats\Borough.Formats.csproj" />
    <ProjectReference Include="..\..\src\Borough.Headless\Borough.Headless.csproj" />

    <!--
      A plain reference, deliberately. Borough.Core consumes this as an analyser; the tests consume
      it as a library, because they instantiate each DiagnosticAnalyzer and run it over a probe
      compilation. Analysing the test assembly itself is not wanted — the tests are ordinary C# by
      adr/0036's zone table, and half of them exist to write the violations on purpose.
    -->
    <ProjectReference Include="..\..\src\Borough.Analysers\Borough.Analysers.csproj" />
  </ItemGroup>

</Project>
