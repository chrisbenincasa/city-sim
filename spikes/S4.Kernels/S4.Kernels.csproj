<Project Sdk="Microsoft.NET.Sdk">

  <!--
    S4, the kernel benchmark. plans/0004-s4-kernel-benchmark.md.

    This project references nothing of ours, and must not: there is nothing in Borough.Core yet
    and the whole point of the spike is that there never needs to be.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      The GC configuration is K6's subject, and it is deliberately NOT set here.

      These two properties bake values into runtimeconfig.json, and runtimeconfig.json is not
      uniformly overridable from the environment: DOTNET_gcServer wins over it, DOTNET_gcConcurrent
      does not. Setting them cost K6 half its matrix once already — the first sweep asked for four
      configurations, silently ran two, and only the report's printback of the *effective* settings
      revealed it.

      Absent, the runtime defaults are workstation GC with background collection on, which is what
      these lines specified anyway. K0-K5 are therefore unaffected, and K6 can now vary both
      dimensions from the environment as tools/k6-run.sh intends.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
