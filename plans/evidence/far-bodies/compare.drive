# Run this capture for any registered far-window option from the repository root:
# name=grid; mkdir -p "plans/evidence/far-bodies/$name"; script=$(mktemp); sed "s/{name}/$name/g" plans/evidence/far-bodies/compare.drive > "$script"; BOROUGH_RENDER_PROFILE=1 godot --path src/Borough.Godot -- --ruleset rulesets/platted.toml --citizens 40000 --drive "$script"; rm "$script"
#
# Each shoot writes a PNG and a readout. The following Tick writes a TSV plus its render profile,
# so BOROUGH_RENDER_PROFILE records frame milliseconds and visible draw calls for that shot.
# The camera keeps one tilt, heading and focus through the whole run.

600 ui far-windows {name}
600 ui family-bodies on
600 roads on
600 tilt 40
600 turn right
600 focus 556 560 3000
600 shoot plans/evidence/far-bodies/{name}/3000.png
601 draw plans/evidence/far-bodies/{name}/3000.tsv

602 focus 556 560 1000
602 shoot plans/evidence/far-bodies/{name}/1000.png
603 draw plans/evidence/far-bodies/{name}/1000.tsv

604 focus 556 560 500
