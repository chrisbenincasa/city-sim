{
    // Markdown opens in preview because this repository is mostly prose.
    "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor"
    },

    // Do not format markdown. The global editor.formatOnSave sends .md to Prettier, which cannot
    // produce house style (*emphasis* is rewritten to _emphasis_ with no option to prevent it) and
    // whose table padding takes plans/0000-board.md from 82 KB to 182 KB, because it pads every
    // cell in a column to the widest and that table has a 4,166-character cell.
    //
    // .prettierignore carries the same refusal for Prettier run any other way. House style is
    // enforced by tests/Borough.Tests/Corpus/MarkdownStyleTests.cs.
    // Ruleset autocomplete and type hints, via Even Better TOML (tamasfe.even-better-toml).
    //
    // The schema is GENERATED from RulesetLoader -- `--schema` -- because the loader already
    // derives its permitted key set from the readers, and a hand-written schema would be a second
    // copy of it. RulesetSchemaTests fails when the committed file drifts.
    //
    // The association lives here rather than as an `#:schema` line in each Ruleset because
    // declining.toml and congested.toml are golden-baseline artefacts whose recorded content hash
    // moves when they are edited at all, comments included.
    "evenBetterToml.schema.associations": {
        "rulesets/.*\\.toml$": "./rulesets/ruleset.schema.json"
    },

    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.defaultFormatter": null
    }
}
